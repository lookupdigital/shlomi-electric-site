# Copy to .env.local and fill in. Same values go into Vercel → Settings → Environment Variables.

# Public (inlined into the browser bundle at build time; safe because RLS protects all tables)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret — bypasses Row Level Security. Used only by src/lookup/supabase/service.ts.
# Never expose to the browser, never prefix with NEXT_PUBLIC_, mark as "Sensitive" in Vercel.
SUPABASE_SERVICE_ROLE_KEY=
