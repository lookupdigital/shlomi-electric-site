# Lookup Starter — environment variables. Names only: NEVER put real values in this file.
# Local: copy to .env.local (git-ignored). Vercel: Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time: never secrets; redeploy after changing them.
# Full reference with the Preview/Production matrix: docs/environment-variables.md

# ══ REQUIRED (all environments) ═════════════════════════════════════════════════════════════════════
# Supabase → Project Settings → API Keys. Project URL including https://
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (sb_publishable_…) or legacy anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY secret (sb_secret_… or legacy service_role). Bypasses RLS; used by the lead pipeline only.
# Vercel: mark Sensitive. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ══ RECOMMENDED (Production) ════════════════════════════════════════════════════════════════════════
# Cloudflare Turnstile. Both or neither. Without them the lead form relies on honeypot + rate limiting only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 32+ random characters. Keys the IP hash of the lead rate limiter (falls back to a hash of the service role key).
LEAD_RATE_LIMIT_SALT=
# Canonical origin, e.g. https://www.example.com — used only while Admin → Site settings → Site URL is empty
# (then VERCEL_PROJECT_PRODUCTION_URL, then localhost).
LOOKUP_SITE_URL=

# ══ OPTIONAL ════════════════════════════════════════════════════════════════════════════════════════
# Lead webhook (Make, Zapier, n8n, CRM). Signed JSON POST per lead; both variables together.
# Preview: point at a TEST endpoint or leave empty (every Preview lead is a test lead).
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
# Admin host isolation, e.g. admin.example.com (docs/optional-integrations.md). Build-time value.
NEXT_PUBLIC_ADMIN_HOST=

# ══ PRODUCTION-ONLY (only when hosting outside Vercel) ═══════════════════════════════════════════════
# production | preview | development. On Vercel leave EMPTY: VERCEL_ENV decides. Anything else = development
# (never indexable, GTM not loaded, leads stored as test).
LOOKUP_SITE_ENV=

# ══ PREVIEW-ONLY ════════════════════════════════════════════════════════════════════════════════════
# 1 = load GTM on a non-production deployment to test a container. Never set in Production.
LOOKUP_GTM_DEBUG=

# ══ DO NOT SET IN PRODUCTION ════════════════════════════════════════════════════════════════════════
# 16+ random characters. Lets the Playwright test mark its lead as is_test. Local / CI secrets only.
E2E_TEST_TOKEN=
