# Copy to .env.local and fill in. The same names go into Vercel → Settings → Environment Variables.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time: never put secrets in them.

# ── Supabase (required) ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret — bypasses Row Level Security. Used only by the lead pipeline. Mark "Sensitive" in Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# ── Environment ─────────────────────────────────────────────────────────────────────────────────────
# production | preview | development. Falls back to VERCEL_ENV on Vercel; anything else = development
# (never indexable, GTM not loaded). Set to "production" when hosting the live site outside Vercel.
LOOKUP_SITE_ENV=
# Site URL used for canonicals when the "site URL" admin setting is empty (falls back to VERCEL_PROJECT_PRODUCTION_URL).
LOOKUP_SITE_URL=
# Set to 1 to load GTM outside production (e.g. to test a container on a preview deployment).
LOOKUP_GTM_DEBUG=
# Optional admin host isolation, e.g. admin.example.com (see docs/security-architecture.md).
NEXT_PUBLIC_ADMIN_HOST=

# ── Lead notifications (optional, recommended) ──────────────────────────────────────────────────────
# Generic webhook (Make, Zapier, n8n, CRM, email relay). Receives a signed JSON POST per new lead.
LEAD_WEBHOOK_URL=
# Shared secret for the X-Lookup-Signature HMAC header.
LEAD_WEBHOOK_SECRET=

# ── Anti-spam ───────────────────────────────────────────────────────────────────────────────────────
# Cloudflare Turnstile (optional, recommended). Both keys are needed to enable it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Secret used to hash client IPs for rate limiting (defaults to a hash keyed by the service role key).
LEAD_RATE_LIMIT_SALT=

# ── Tests (never set in production) ────────────────────────────────────────────────────────────────
# 16+ random characters. Lets the Playwright test store its lead as is_test.
E2E_TEST_TOKEN=
